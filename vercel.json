{
    "version": 2,
    "builds": [
        {
            "src": "Backend/app.js",
            "use": "@vercel/node"
        },
        {
            "src": "Frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/Backend/app.js"
        },
        {
            "source": "/favicon.ico",
            "destination": "/Frontend/vite.svg"
        },
        {
            "source": "/(.*)",
            "destination": "/Frontend/$1",
            "condition": "status == 404"
        },
        {
            "source": "/(.*)",
            "destination": "/Frontend/index.html"
        }
    ]
}