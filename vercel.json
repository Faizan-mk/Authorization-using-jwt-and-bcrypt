{
    "version": 2,
    "builds": [
        {
            "src": "Backend/app.js",
            "use": "@vercel/node"
        },
        {
            "src": "Frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/Backend/app.js"
        },
        {
            "src": "/(favicon.ico|favicon.png)",
            "dest": "/Frontend/vite.svg"
        },
        {
            "src": "/(.*)",
            "dest": "/Frontend/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "status": 200,
            "dest": "/Frontend/index.html"
        }
    ]
}